{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/schemas/fleet/fleet.schema.json",
  "title": "fleet.json",
  "description": "Owner: captain. Always exists, including L (1 DAG). Index of DAG-of-DAG. See docs/design/2026-07-12-fleet-revamp.mdx §State — fleet.json & state.json. failedDags[] intentionally absent — derivable from dags[].status.",
  "type": "object",
  "required": ["meta", "git", "dags", "stopFlag"],
  "properties": {
    "meta": {
      "type": "object",
      "description": "createdAt/mapRef/budget optional per doc ('?').",
      "required": ["runName", "schemaVersion", "createdAt", "baseBranch", "integrationBranch", "maxConcurrent"],
      "properties": {
        "runName": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "baseBranch": { "type": "string", "minLength": 1 },
        "integrationBranch": {
          "type": "string",
          "pattern": "^fleet/[^/]+/int$",
          "description": "fleet/<run>/int"
        },
        "mapRef": { "type": "string", "description": "optional — only set for XL (wayfinder map)" },
        "maxConcurrent": { "type": "integer", "minimum": 1 },
        "budget": { "type": "number", "minimum": 0, "description": "optional token/cost ceiling" }
      }
    },
    "git": {
      "type": "object",
      "required": ["remote", "webTemplate"],
      "properties": {
        "remote": { "type": "string", "minLength": 1 },
        "webTemplate": {
          "type": "string",
          "pattern": "\\{sha\\}",
          "description": "e.g. '.../commit/{sha}' — URL derived, sha not stored per node"
        }
      }
    },
    "dags": {
      "type": "array",
      "items": { "$ref": "#/$defs/dag" }
    },
    "stopFlag": { "$ref": "#/$defs/stopFlag" }
  },
  "$defs": {
    "dag": {
      "type": "object",
      "required": ["id", "ref", "title", "statePath", "dependsOn", "status", "judge", "attributes", "audit"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1, "description": "specRef" },
        "title": { "type": "string" },
        "statePath": { "type": "string", "minLength": 1, "description": "relative to run dir, e.g. dags/<id>/state.json" },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["PENDING", "IMPLEMENTING", "STANDARDS_REVIEW", "CHECKING", "SPEC_REVIEW", "FIXING", "PASSED", "FAILED", "BLOCKED", "ESCALATED"] },
        "judge": {
          "type": "object",
          "required": ["verdict", "attempt"],
          "properties": {
            "verdict": { "enum": [null, "PASS", "FAIL", "BLOCKED", "ESCALATE"] },
            "attempt": { "type": "integer", "minimum": 0, "maximum": 2, "description": "bounded 2x per doc" }
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "audit": {
          "type": "array",
          "items": { "$ref": "#/$defs/auditSpan" }
        }
      }
    },
    "auditSpan": {
      "description": "OTel-span-shaped, 1 entry per spawn. Shared shape — duplicated verbatim in state.schema.json for offline $ref-free validation.",
      "type": "object",
      "required": ["role", "agentType", "model", "agentId", "startedAt", "endedAt", "status", "error", "summary", "attributes"],
      "properties": {
        "role": { "enum": ["worker", "reviewer", "judge", "orchestrator", "steering"] },
        "agentType": { "type": "string", "description": "pointer tier, e.g. implementer (intent)" },
        "model": { "type": "string", "description": "resolved model, e.g. cx/gpt-5.6-terra (fact)" },
        "agentId": { "type": ["string", "null"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": ["string", "null"], "format": "date-time" },
        "status": { "enum": ["pending", "running", "ok", "error"] },
        "error": { "type": ["string", "null"], "description": "verbatim, first-class; invariant: error != null <=> status:error" },
        "summary": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": { "type": "string" } },
        "reportRef": { "type": "string", "description": "optional pointer to long-form report" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
          "then": { "required": ["error"], "properties": { "error": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["pending", "running", "ok"] } }, "required": ["status"] },
          "then": { "properties": { "error": { "type": "null" } } }
        }
      ]
    },
    "stopFlag": {
      "type": "object",
      "required": ["stopped", "reason", "stoppedAt"],
      "properties": {
        "stopped": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "stoppedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
