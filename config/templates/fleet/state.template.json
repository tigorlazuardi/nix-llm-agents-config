{
  "meta": {
    "runName": "demo-run",
    "schemaVersion": 2,
    "specRef": "specs/<spec-name>.md",
    "standardsRef": "CODING_STANDARDS.md",
    "baseBranch": "main",
    "integrationBranch": "fleet/demo-run/int",
    "orchestrator": { "agent": "orchestrator", "model": "cx/gpt-5.6-terra", "thinking": "low" },
    "maxFixAttempts": 3,
    "maxHandoverAttempts": 3,
    "maxReviewerRetries": 3,
    "maxCheckRetries": 1
  },
  "tracker": { "type": "local-md", "supportsBlocking": true },
  "nodes": [
    {
      "id": "t1",
      "ticket": { "ref": "tickets/t1.md", "title": "<ticket-title>" },
      "dependsOn": [],
      "routing": {
        "failureTolerance": "standard",
        "worker": "worker",
        "reviewer": "worker",
        "checkCommand": "npm test -- t1"
      },
      "runtime": {
        "status": "PENDING",
        "phase": "PENDING",
        "currentChild": null,
        "reviewAxis": null,
        "fixAttempt": 0,
        "handoverAttempt": 0,
        "reviewerRetry": { "standards": 0, "spec": 0 },
        "checkRetry": 0,
        "branch": "fleet/demo-run/task/d1/t1",
        "commitSha": null,
        "evidence": {
          "implementationRef": null,
          "standardsReviewRef": null,
          "checkRef": null,
          "specReviewRef": null
        }
      },
      "sync": { "mirrored": false, "pushed": false },
      "attributes": {},
      "audit": []
    }
  ],
  "stopFlag": { "stopped": false, "reason": null, "stoppedAt": null }
}
