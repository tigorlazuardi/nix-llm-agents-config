+/**
+ * Best-effort `PI_RELAY_ANNOTATIONS` for the relay extension: who this child is
+ * and what it works on. Display metadata only, never identity or authority.
+ * Keys and limits follow the relay's annotation rules (value <= 256 bytes, no
+ * control characters); the task is its first non-empty line, capped at 80.
+ */
+function relayAnnotationsAssignment(request: {
+	name: string;
+	agent?: string | undefined;
+	task: string;
+}): string {
+	const clean = (value: string, max: number): string =>
+		Array.from(
+			value.replace(/[\u0000-\u001f\u007f-\u009f\u2028\u2029]/g, " ").trim(),
+		)
+			.slice(0, max)
+			.join("");
+	const firstLine = request.task.split(/\r?\n/).find((line) => line.trim());
+	const annotations: Record<string, string> = {
+		role: clean(request.agent || "subagent", 60),
+		name: clean(request.name, 60),
+	};
+	const task = clean(firstLine ?? "", 80);
+	if (task) annotations.task = task;
+	return `PI_RELAY_ANNOTATIONS=${shellQuote(JSON.stringify(annotations))}`;
+}
