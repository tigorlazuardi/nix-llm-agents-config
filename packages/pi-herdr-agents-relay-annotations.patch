+/**
+ * Restricted-charset label for anything exported as a relay label: only
+ * `[A-Za-z0-9._-]` survives, capped at 40 characters.
+ */
+function restrictedRelayLabel(value: string | undefined): string {
+	return (value ?? "").replace(/[^A-Za-z0-9._-]/g, "").slice(0, 40);
+}
+
+/**
+ * Best-effort `PI_RELAY_ANNOTATIONS` for the relay extension: short labels for
+ * who this child is. Display metadata only, never identity or authority.
+ * Only called for real children (`subagent` marks them; `parent` is the
+ * parent's Pi session id, which the relay also publishes as `session`).
+ * Deliberately carries no task or prompt text: roster values reach other
+ * agents' context, so only restricted-charset labels may pass.
+ */
+function relayAnnotationsAssignment(request: {
+	name: string;
+	agent?: string | undefined;
+	parent: { sessionId: string };
+}): string {
+	const annotations: Record<string, string> = { subagent: "true" };
+	const name = restrictedRelayLabel(request.name);
+	if (name) annotations.name = name;
+	const role = restrictedRelayLabel(request.agent);
+	if (role) annotations.role = role;
+	const parent = restrictedRelayLabel(request.parent.sessionId);
+	if (parent) annotations.parent = parent;
+	return `PI_RELAY_ANNOTATIONS=${shellQuote(JSON.stringify(annotations))}`;
+}
+
+/**
+ * `PI_SUBAGENT_PARENT_SESSION` for a real child: the parent's Pi session id,
+ * published by the relay as the `session` annotation, so a child can find its
+ * parent with `relay_list_peers`. Same restricted-charset label rule; omitted
+ * entirely when nothing survives, so an empty value is never exported.
+ */
+function parentSessionAssignment(parentSessionId: string): string | null {
+	const label = restrictedRelayLabel(parentSessionId);
+	return label ? `PI_SUBAGENT_PARENT_SESSION=${shellQuote(label)}` : null;
+}
