+/**
+ * Best-effort `PI_RELAY_ANNOTATIONS` for the relay extension: short labels for
+ * who this child is. Display metadata only, never identity or authority.
+ * Only called for real children (`subagent` marks them; `parent` is the
+ * parent's Pi session id, which the relay also publishes as `session`).
+ * Deliberately carries no task or prompt text: roster values reach other
+ * agents' context, so only restricted-charset labels may pass.
+ */
+function relayAnnotationsAssignment(request: {
+	name: string;
+	agent?: string | undefined;
+	parent: { sessionId: string };
+}): string {
+	const label = (value: string | undefined): string =>
+		(value ?? "").replace(/[^A-Za-z0-9._-]/g, "").slice(0, 40);
+	const annotations: Record<string, string> = { subagent: "true" };
+	const name = label(request.name);
+	if (name) annotations.name = name;
+	const role = label(request.agent);
+	if (role) annotations.role = role;
+	const parent = label(request.parent.sessionId);
+	if (parent) annotations.parent = parent;
+	return `PI_RELAY_ANNOTATIONS=${shellQuote(JSON.stringify(annotations))}`;
+}
+
 function buildPiCommand(
 	resolved: ResolvedLaunch,
 	artifacts: PreparedArtifacts,
