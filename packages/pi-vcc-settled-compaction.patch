diff --git a/tests/settled-compaction.test.ts b/tests/settled-compaction.test.ts
new file mode 100644
index 0000000..c2f4e3b
--- /dev/null
+++ b/tests/settled-compaction.test.ts
@@ -0,0 +1,165 @@
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { mkdtempSync, rmSync, writeFileSync } from "fs";
+import { tmpdir } from "os";
+import { join } from "path";
+import {
+  PI_VCC_SETTLED_COMPACT_INSTRUCTION,
+  registerBeforeCompactHook,
+  resolveAutoCompactionThreshold,
+} from "../src/hooks/before-compact";
+import { DEFAULT_SETTINGS } from "../src/core/settings";
+
+let tmpDir: string;
+let configPath: string;
+
+const writeConfig = (autoCompaction: Record<string, unknown>) => {
+  writeFileSync(configPath, JSON.stringify({
+    overrideDefaultCompaction: true,
+    smartKeepTail: true,
+    continueAfterThresholdCompact: true,
+    autoCompaction,
+    debug: false,
+  }));
+};
+
+const makeHarness = ({
+  tokens,
+  modelId = "cc/claude-opus-5",
+  contextWindow = 288_000,
+  idle = true,
+}: {
+  tokens: number;
+  modelId?: string;
+  contextWindow?: number;
+  idle?: boolean;
+}) => {
+  const handlers = new Map<string, (event: any, ctx: any) => any>();
+  const compactCalls: any[] = [];
+  let isIdle = idle;
+  const pi = {
+    on: (name: string, handler: (event: any, ctx: any) => any) => handlers.set(name, handler),
+    sendMessage: () => {},
+    sendUserMessage: () => {},
+  } as any;
+  const ctx = {
+    model: { id: modelId, contextWindow },
+    isIdle: () => isIdle,
+    getContextUsage: () => ({ tokens, contextWindow, percent: tokens / contextWindow }),
+    compact: (options: any) => compactCalls.push(options),
+    ui: { notify: () => {} },
+  };
+  registerBeforeCompactHook(pi);
+  return {
+    compactCalls,
+    invoke: (name: string, event: any = {}) => handlers.get(name)?.(event, ctx),
+    setIdle: (value: boolean) => { isIdle = value; },
+  };
+};
+
+const thresholdEvent = (tokensBefore: number) => ({
+  type: "session_before_compact",
+  reason: "threshold",
+  willRetry: false,
+  customInstructions: undefined,
+  branchEntries: [],
+  preparation: {
+    previousSummary: undefined,
+    fileOps: { read: [], written: [], edited: [] },
+    tokensBefore,
+  },
+});
+
+describe("settled absolute auto-compaction", () => {
+  beforeEach(() => {
+    tmpDir = mkdtempSync(join(tmpdir(), "pi-vcc-settled-test-"));
+    configPath = join(tmpDir, "config.json");
+    process.env.PI_VCC_CONFIG_PATH = configPath;
+  });
+
+  afterEach(() => {
+    delete process.env.PI_VCC_CONFIG_PATH;
+    rmSync(tmpDir, { recursive: true, force: true });
+  });
+
+  test("resolves a model override without changing the default", () => {
+    const settings = {
+      ...DEFAULT_SETTINGS,
+      autoCompaction: {
+        enabled: true,
+        thresholdTokens: 150_000,
+        modelThresholdTokens: { "cc/claude-haiku-4-5-20251001": 136_000 },
+      },
+    };
+    expect(resolveAutoCompactionThreshold(settings, "cc/claude-haiku-4-5-20251001")).toBe(136_000);
+    expect(resolveAutoCompactionThreshold(settings, "cc/claude-opus-5")).toBe(150_000);
+  });
+
+  test("does not compact below the absolute threshold", () => {
+    writeConfig({ enabled: true, thresholdTokens: 150_000, modelThresholdTokens: {} });
+    const harness = makeHarness({ tokens: 149_999 });
+    harness.invoke("agent_settled");
+    expect(harness.compactCalls).toEqual([]);
+  });
+
+  test("cancels Pi threshold during the active turn then compacts after agent_settled", () => {
+    writeConfig({ enabled: true, thresholdTokens: 150_000, modelThresholdTokens: {} });
+    const harness = makeHarness({ tokens: 150_000, idle: false });
+    expect(harness.invoke("session_before_compact", thresholdEvent(150_000))).toEqual({ cancel: true });
+    expect(harness.compactCalls).toEqual([]);
+
+    harness.setIdle(true);
+    harness.invoke("agent_settled");
+    expect(harness.compactCalls).toHaveLength(1);
+    expect(harness.compactCalls[0].customInstructions).toBe(PI_VCC_SETTLED_COMPACT_INSTRUCTION);
+    harness.compactCalls[0].onComplete();
+  });
+
+  test("uses the Haiku safety override", () => {
+    writeConfig({
+      enabled: true,
+      thresholdTokens: 150_000,
+      modelThresholdTokens: { "cc/claude-haiku-4-5-20251001": 136_000 },
+    });
+    const harness = makeHarness({
+      tokens: 136_000,
+      modelId: "cc/claude-haiku-4-5-20251001",
+      contextWindow: 200_000,
+    });
+    harness.invoke("agent_settled");
+    expect(harness.compactCalls).toHaveLength(1);
+    harness.compactCalls[0].onComplete();
+  });
+
+  test("suppresses reserve-based preemption below the absolute threshold", () => {
+    writeConfig({ enabled: true, thresholdTokens: 150_000, modelThresholdTokens: {} });
+    const harness = makeHarness({ tokens: 80_000, idle: true });
+    expect(harness.invoke("session_before_compact", thresholdEvent(80_000))).toEqual({ cancel: true });
+    expect(harness.compactCalls).toEqual([]);
+  });
+
+  test("falls back to Pi safety when threshold is outside model capability", () => {
+    writeConfig({ enabled: true, thresholdTokens: 150_000, modelThresholdTokens: {} });
+    const harness = makeHarness({ tokens: 150_000, contextWindow: 128_000, idle: false });
+    const event = thresholdEvent(150_000);
+    event.branchEntries = [
+      { id: "u1", type: "message", message: { role: "user", content: "one" } },
+      { id: "a1", type: "message", message: { role: "assistant", content: "reply one" } },
+      { id: "u2", type: "message", message: { role: "user", content: "two" } },
+      { id: "a2", type: "message", message: { role: "assistant", content: "reply two" } },
+    ];
+    expect(harness.invoke("session_before_compact", event)).toHaveProperty("compaction");
+    harness.setIdle(true);
+    harness.invoke("agent_settled");
+    expect(harness.compactCalls).toEqual([]);
+  });
+
+  test("allows another settled compaction after completion", () => {
+    writeConfig({ enabled: true, thresholdTokens: 150_000, modelThresholdTokens: {} });
+    const harness = makeHarness({ tokens: 160_000 });
+    harness.invoke("agent_settled");
+    harness.compactCalls[0].onComplete();
+    harness.invoke("agent_settled");
+    expect(harness.compactCalls).toHaveLength(2);
+    harness.compactCalls[1].onComplete();
+  });
+});
