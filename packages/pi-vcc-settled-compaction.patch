+const isPositiveInteger = (value: unknown): value is number =>
+  typeof value === "number" && Number.isSafeInteger(value) && value > 0;
+
+const normalizeAutoCompaction = (value: unknown): PiVccSettings["autoCompaction"] => {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    return { ...DEFAULT_SETTINGS.autoCompaction };
+  }
+  const raw = value as Record<string, unknown>;
+  const rawModelThresholds = raw.modelThresholdTokens;
+  const modelThresholdTokens = rawModelThresholds && typeof rawModelThresholds === "object" && !Array.isArray(rawModelThresholds)
+    ? Object.fromEntries(
+        Object.entries(rawModelThresholds).filter(([, threshold]) => isPositiveInteger(threshold)),
+      ) as Record<string, number>
+    : {};
+  return {
+    enabled: typeof raw.enabled === "boolean" ? raw.enabled : DEFAULT_SETTINGS.autoCompaction.enabled,
+    thresholdTokens: isPositiveInteger(raw.thresholdTokens)
+      ? raw.thresholdTokens
+      : DEFAULT_SETTINGS.autoCompaction.thresholdTokens,
+    modelThresholdTokens,
+  };
+};
